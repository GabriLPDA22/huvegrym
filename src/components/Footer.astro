---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { LANG_LABEL, type Alternates, type Lang } from '@/i18n/config';
import { routes, SECTION, sectionHref } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import { site } from '@/data/site';
import { artists } from '@/data/artists';
import { pieces } from '@/data/pieces';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const year = new Date().getFullYear();
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_GA_ID);

const company = [
  { href: sectionHref(lang, SECTION.about), label: ui.nav.about[lang] },
  { href: sectionHref(lang, SECTION.videos), label: ui.nav.videos[lang] },
  { href: sectionHref(lang, SECTION.venues), label: ui.nav.venues[lang] },
  { href: sectionHref(lang, SECTION.dates), label: ui.nav.dates[lang] },
];
---

<footer class="footer">
  <div class="container">
    <a class="footer__logo" href={routes.home[lang]} aria-label={`${site.name} — ${ui.home[lang]}`}>
      <Wordmark />
    </a>

    <div class="footer__grid">
      <nav aria-label={ui.nav.about[lang]}>
        <p class="footer__title">{site.name}</p>
        <ul role="list">
          {
            company.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label={ui.nav.artists[lang]}>
        <p class="footer__title">{ui.nav.artists[lang]}</p>
        <ul role="list">
          {
            artists.map((a) => (
              <li>
                <a href={routes.artist(a.slug)[lang]}>{a.fullName}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label={ui.nav.pieces[lang]}>
        <p class="footer__title">{ui.nav.pieces[lang]}</p>
        <ul role="list">
          {
            pieces.map((p) => (
              <li>
                <a href={routes.piece(p.slug)[lang]}>{p.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer__contact">
        <p class="footer__title">{ui.nav.contact[lang]}</p>
        <ul role="list">
          <li>
            <a href={`mailto:${site.email}`} class="footer__icon-link"><Icon name="mail" />{site.email}</a>
          </li>
          <li>
            <a href={site.instagram.url} target="_blank" rel="noopener" class="footer__icon-link"
              ><Icon name="instagram" />{site.instagram.handle}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.name}. {ui.footerRights[lang]}</p>
      <p class="footer__links">
        <a href={alternates[other]} hreflang={other} lang={other}>{LANG_LABEL[other].long}</a>
        <a href={routes.cookies[lang]}>{ui.cookiePolicy[lang]}</a>
        {
          analyticsEnabled && (
            <button type="button" data-consent-open>
              {ui.cookieSettings[lang]}
            </button>
          )
        }
      </p>
      <p>
        {ui.footerCredits[lang]}
        <a href={site.developer.url} class="footer__dev">{site.developer.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    border-top: 1px solid var(--line);
    background: var(--ink);
    font-size: var(--fs-sm);
  }

  .footer__logo {
    display: block;
    width: min(100%, 36rem);
    color: var(--bone);
    transition: color 0.4s;
  }

  .footer__logo:hover {
    color: var(--gold);
  }

  .footer__logo :global(svg) {
    width: 100%;
    height: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .footer__title {
    margin-bottom: 0.75rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer__grid a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--bone-dim);
    transition: color 0.3s;
  }

  .footer__grid a:hover {
    color: var(--gold);
  }

  .footer__icon-link {
    gap: 0.6rem;
    white-space: nowrap;
  }

  /* En móvil el contacto ocupa todo el ancho: el email nunca se parte */
  .footer__contact {
    grid-column: 1 / -1;
  }

  .footer__icon-link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }

  .footer__bottom {
    display: grid;
    gap: 0.75rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .footer__bottom a,
  .footer__bottom button {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--bone-dim);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: color 0.3s;
  }

  .footer__bottom a:hover,
  .footer__bottom button:hover {
    color: var(--gold);
  }

  @media (min-width: 48em) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    }

    .footer__contact {
      grid-column: auto;
    }

    .footer__bottom {
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }

    .footer__links {
      justify-content: center;
    }
  }
</style>
