---
/** Crédito del fotógrafo en formato píldora (enlace a su Instagram). */
import type { Credit } from '@/data/credits';
import type { Lang } from '@/i18n/config';
import { ui } from '@/i18n/ui';

interface Props {
  credit: Credit;
  lang: Lang;
  class?: string;
}
const { credit, lang, class: className } = Astro.props;
---

<a
  class:list={['photo-credit', className]}
  href={credit.url}
  target="_blank"
  rel="noopener"
  aria-label={`${ui.photo[lang]}: ${credit.handle} (Instagram)`}
>
  <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false">
    <path d="M4 8h3l1.5-2h7L17 8h3v11H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <circle cx="12" cy="13" r="3.3" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
  </svg>
  {credit.handle}
</a>
