---
import { Picture } from 'astro:assets';
import SectionHeading from '@/components/SectionHeading.astro';
import type { Lang } from '@/i18n/config';
import { SECTION } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import { about } from '@/data/site';
import duo from '@/assets/images/hero/duo-smoke.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id={SECTION.about} class="section about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__text">
      <SectionHeading id="about-title" index={1} kicker={ui.aboutKicker[lang]} lines={ui.aboutTitle[lang]} />
      <p class="lead about__lead" data-reveal>{about.lead[lang]}</p>
      <p class="about__body" data-reveal>{about.body[lang]}</p>
    </div>

    <figure class="about__media" data-reveal>
      <div class="about__frame">
        <Picture
          src={duo}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[420, 640, 900, 1200]}
          sizes="(min-width: 64em) 40vw, 100vw"
          alt={lang === 'es'
            ? 'Dúo de Huvegrym bailando entre humo en un escenario'
            : 'Huvegrym duo dancing amid stage smoke'}
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .about {
    overflow: clip;
  }

  .about__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .about__lead {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 34ch;
  }

  .about__body {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--bone-dim);
  }

  .about__media {
    position: relative;
  }

  .about__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink-3);
  }

  .about__frame :global(img) {
    width: 100%;
    height: 115%;
    object-fit: cover;
  }

  /* Parallax nativo (scroll-driven animations) — 0 JS, se ignora si no hay soporte */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about__frame :global(img) {
        animation: about-parallax linear both;
        animation-timeline: view();
      }
    }
  }

  @keyframes about-parallax {
    from {
      transform: translateY(-12%);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (min-width: 64em) {
    .about__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
</style>
