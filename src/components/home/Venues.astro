---
import { Picture } from 'astro:assets';
import SectionHeading from '@/components/SectionHeading.astro';
import type { Lang } from '@/i18n/config';
import { SECTION } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import { venues, VENUE_CATEGORIES } from '@/data/venues';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const groups = VENUE_CATEGORIES.map((c) => ({ id: c, items: venues.filter((v) => v.category === c) }));
---

<section id={SECTION.venues} class="section venues" aria-labelledby="venues-title">
  <div class="container">
    <SectionHeading id="venues-title" index={6} kicker={ui.venuesKicker[lang]} lines={ui.venuesTitle[lang]} />

    <div class="venues__groups">
      {
        groups.map((g, gi) => (
          <div class="venue-group" data-reveal style={`--i:${gi}`}>
            <h3 class="venue-group__title">
              {ui.venueCategory[g.id][lang]}
              <span>{String(g.items.length).padStart(2, '0')}</span>
            </h3>
            <ul class="venue-list" role="list">
              {g.items.map((v) => (
                <li class="venue" id={v.id}>
                  <div class="venue__img">
                    <Picture
                      src={v.image}
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[160, 320, 480, 720]}
                      sizes="(min-width: 64em) 28vw, 6.5rem"
                      alt={v.city ? `${v.name}, ${v.city}` : v.name}
                      loading="lazy"
                    />
                  </div>
                  <div class="venue__text">
                    <p class="venue__name">{v.name}</p>
                    {v.city && <p class="venue__city">{v.city}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .venues__groups {
    display: grid;
    gap: 3rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .venue-group__title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1.4;
  }

  .venue-group__title span {
    color: var(--muted);
  }

  .venue {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .venue__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-3);
  }

  .venue__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.8);
    transition:
      filter 0.6s,
      scale 1s var(--ease-out);
  }

  .venue__name {
    font-family: var(--ff-serif);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.1;
  }

  .venue__city {
    margin-top: 0.3rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (hover: hover) {
    .venue:hover .venue__img :global(img) {
      filter: none;
      scale: 1.05;
    }
    .venue:hover .venue__name {
      color: var(--gold);
    }
  }

  @media (min-width: 64em) {
    .venues__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
    }

    .venue {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .venue__img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
