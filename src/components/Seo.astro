---
import { HTML_LANG, OG_LOCALE, type Alternates, type Lang } from '@/i18n/config';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Alternates;
  ogImage: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, alternates, ogImage, ogImageAlt = site.name, ogType = 'website', noindex = false, jsonLd } =
  Astro.props;

const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(alternates[lang], origin).href;
const image = new URL(ogImage, origin).href;
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{
  !noindex && (
    <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang={HTML_LANG.es} href={new URL(alternates.es, origin).href} />
      <link rel="alternate" hreflang={HTML_LANG.en} href={new URL(alternates.en, origin).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, origin).href} />
    </>
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:locale:alternate" content={OG_LOCALE[otherLang]} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{gsc && <meta name="google-site-verification" content={gsc} />}

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
