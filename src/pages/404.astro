---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { routes } from '@/i18n/routes';
import { seo } from '@/data/site';
---

<BaseLayout
  lang="es"
  title="Página no encontrada | Huvegrym"
  description={seo.home.description.es}
  alternates={routes.home}
  ogImage={seo.home.ogImage}
  noindex
>
  <section class="nf container">
    <p class="kicker">Error 404</p>
    <h1 class="section-title">
      <span>Este paso</span>
      <span class="accent">no existe</span>
    </h1>
    <p class="nf__text">La página que buscas se ha movido o ya no está. · The page you are looking for does not exist.</p>
    <div class="nf__actions">
      <a class="btn" href={routes.home.es}>Volver al inicio <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={routes.home.en}>English</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 2rem) 4rem;
  }

  .nf__text {
    margin-block: 2rem;
    max-width: 50ch;
    color: var(--bone-dim);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
