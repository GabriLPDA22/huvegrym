# Google Analytics 4 — ID de medición (Administrar > Flujos de datos > Web).
# Si se deja vacío no se carga ningún script de analítica ni el banner de cookies.
PUBLIC_GA_ID=

# Google Search Console — valor "content" de la meta google-site-verification.
# Alternativa recomendada: verificar el dominio por DNS (registro TXT) y dejar esto vacío.
PUBLIC_GSC_VERIFICATION=
